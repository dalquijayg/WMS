<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WMS_Movil.ListRechequeo"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F1F5F9">

    <Grid>
        <ScrollView>
            <StackLayout Spacing="0">

                <!-- ══════════════════════════════════════
                     HEADER HERO
                     ══════════════════════════════════════ -->
                <Grid HeightRequest="150">
                    <!-- Fondo base -->
                    <BoxView Color="#4C51BF"/>
                    <!-- Círculo decorativo superior derecho -->
                    <BoxView Color="#5558C8"
                             CornerRadius="100"
                             WidthRequest="200" HeightRequest="200"
                             HorizontalOptions="End" VerticalOptions="Start"
                             TranslationX="75" TranslationY="-75"/>
                    <!-- Círculo decorativo inferior izquierdo -->
                    <BoxView Color="#3D42B0"
                             CornerRadius="60"
                             WidthRequest="120" HeightRequest="120"
                             HorizontalOptions="Start" VerticalOptions="End"
                             TranslationX="-40" TranslationY="45"/>

                    <!-- Contenido del header -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          Padding="16,0"
                          VerticalOptions="Center"
                          Margin="0,20,0,0">
                        <Frame Grid.Column="0"
                               BackgroundColor="#3B3FA0"
                               CornerRadius="12"
                               WidthRequest="38" HeightRequest="38"
                               Padding="0" HasShadow="False">
                            <Label Text="←" TextColor="White" FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBackClicked"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Frame>

                        <StackLayout Grid.Column="1"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="2">
                            <Label Text="Rechequeo"
                                   TextColor="White"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                            <Label Text="Paso 1: tarjeta de la tarima preparada"
                                   TextColor="#C7D2FE"
                                   FontSize="11"
                                   HorizontalTextAlignment="Center"/>
                        </StackLayout>

                        <Frame Grid.Column="2"
                               BackgroundColor="#3B3FA0"
                               CornerRadius="12"
                               WidthRequest="38" HeightRequest="38"
                               Padding="7" HasShadow="False">
                            <Label Text="✅" FontSize="16"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                        </Frame>
                    </Grid>
                </Grid>

                <!-- ══════════════════════════════════════
                     TARJETA: LEER TARJETA NFC
                     La tarjeta NFC de la tarima tiene grabado su IdTarima.
                     ══════════════════════════════════════ -->
                <Frame BackgroundColor="White"
                       CornerRadius="20"
                       Padding="18,16"
                       HasShadow="True"
                       Margin="16,-30,16,0">
                    <StackLayout Spacing="14">

                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Frame BackgroundColor="#EEF2FF"
                                   CornerRadius="12"
                                   WidthRequest="42" HeightRequest="42"
                                   Padding="0" HasShadow="False">
                                <Label Text="▥" FontSize="20"
                                       TextColor="#4C51BF"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                            </Frame>
                            <StackLayout Spacing="1" VerticalOptions="Center">
                                <Label Text="📦 TARIMA PREPARADA"
                                       TextColor="#4C51BF"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1"/>
                                <Label Text="La que va a rechequear. Después se le pedirá la tarima de embalaje."
                                       TextColor="#9CA3AF"
                                       FontSize="11"
                                       LineBreakMode="WordWrap"/>
                            </StackLayout>
                        </StackLayout>

                        <BoxView HeightRequest="1" Color="#F1F5F9"/>

                        <StackLayout Spacing="10" Padding="0,8">
                            <Frame x:Name="NfcIconoFrame"
                                   BackgroundColor="#E0E7FF"
                                   CornerRadius="45"
                                   WidthRequest="90" HeightRequest="90"
                                   Padding="0" HasShadow="False"
                                   HorizontalOptions="Center">
                                <Label x:Name="NfcIconoLabel"
                                       Text="📶" FontSize="40"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                            </Frame>
                            <Label x:Name="NfcEstadoLabel"
                                   Text="Esperando tarjeta…"
                                   TextColor="#3730A3"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                            <Label x:Name="NfcDetalleLabel"
                                   Text="Acerque la tarjeta de la tarima preparada a la parte trasera del teléfono"
                                   TextColor="#6B7280"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="WordWrap"/>
                        </StackLayout>

                        <Button x:Name="NfcActivarButton"
                                IsVisible="False"
                                Text="Activar NFC"
                                BackgroundColor="#4C51BF"
                                TextColor="White"
                                CornerRadius="14"
                                HeightRequest="48"
                                FontSize="14"
                                FontAttributes="Bold"
                                Clicked="OnNfcActivarClicked"/>
                    </StackLayout>
                </Frame>

                <BoxView HeightRequest="20" Color="Transparent"/>

            </StackLayout>
        </ScrollView>

        <!-- ══════════════════════════════════════
             OVERLAY DE CARGA
             ══════════════════════════════════════ -->
        <Grid x:Name="LoadingOverlay"
              IsVisible="false"
              BackgroundColor="#80000000">
            <Frame BackgroundColor="White"
                   CornerRadius="20"
                   HeightRequest="104"
                   WidthRequest="104"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Padding="0"
                   HasShadow="True">
                <StackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8">
                    <ActivityIndicator IsRunning="True"
                                       Color="#4C51BF"
                                       HeightRequest="38"
                                       WidthRequest="38"
                                       HorizontalOptions="Center"/>
                    <Label Text="Buscando..."
                           TextColor="#6B7280"
                           FontSize="11"
                           HorizontalOptions="Center"/>
                </StackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>
