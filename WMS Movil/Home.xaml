<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WMS_Movil.Home"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F1F5F9">

    <Grid>
        <RefreshView x:Name="RefreshView"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="#6366F1">
            <ScrollView>
                <StackLayout Spacing="0">

                    <!-- ══════════════════════════════════════
                         HEADER HERO
                         ══════════════════════════════════════ -->
                    <Grid HeightRequest="185">
                        <!-- Fondo base -->
                        <BoxView Color="#4C51BF"/>
                        <!-- Círculo decorativo superior derecho -->
                        <BoxView Color="#5558C8"
                                 CornerRadius="100"
                                 WidthRequest="200" HeightRequest="200"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 TranslationX="75" TranslationY="-75"/>
                        <!-- Círculo decorativo inferior izquierdo -->
                        <BoxView Color="#3D42B0"
                                 CornerRadius="60"
                                 WidthRequest="120" HeightRequest="120"
                                 HorizontalOptions="Start" VerticalOptions="End"
                                 TranslationX="-40" TranslationY="45"/>
                        <!-- Círculo decorativo medio -->
                        <BoxView Color="#4349BB"
                                 CornerRadius="40"
                                 WidthRequest="80" HeightRequest="80"
                                 HorizontalOptions="End" VerticalOptions="End"
                                 TranslationX="-60" TranslationY="20"/>

                        <!-- Contenido del header -->
                        <StackLayout Padding="22,30,22,20" VerticalOptions="Start" Spacing="0">
                            <Label Text="¡Bienvenido de vuelta!"
                                   TextColor="#C7D2FE"
                                   FontSize="12"
                                   CharacterSpacing="0.8"/>
                            <Label x:Name="UserNameLabel"
                                   TextColor="White"
                                   FontSize="21"
                                   FontAttributes="Bold"
                                   Margin="0,4,0,10"/>
                            <Frame BackgroundColor="#3B3FA0"
                                   CornerRadius="20" Padding="10,5"
                                   HasShadow="False" HorizontalOptions="Start">
                                <Label x:Name="DateLabel"
                                       TextColor="#A5B4FC"
                                       FontSize="11"/>
                            </Frame>
                        </StackLayout>
                    </Grid>

                    <!-- ══════════════════════════════════════
                         BANNER: PEDIDO ASIGNADO SIN INICIAR
                         ══════════════════════════════════════ -->
                    <Frame x:Name="BannerPedidoAsignado"
                           IsVisible="False"
                           BackgroundColor="#FFF7ED"
                           BorderColor="#FDBA74"
                           CornerRadius="16"
                           Padding="14,12"
                           HasShadow="True"
                           Margin="16,-30,16,0">
                        <Frame.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBannerPedidoAsignadoTapped"/>
                        </Frame.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Frame Grid.Column="0"
                                   BackgroundColor="#FED7AA"
                                   CornerRadius="10"
                                   WidthRequest="40" HeightRequest="40"
                                   Padding="0" HasShadow="False">
                                <Label Text="⏰" FontSize="20"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                            </Frame>
                            <StackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="BannerTituloLabel"
                                       TextColor="#9A3412"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"/>
                                <Label x:Name="BannerAsignoLabel"
                                       TextColor="#C2410C"
                                       FontSize="11"
                                       LineBreakMode="TailTruncation"/>
                            </StackLayout>
                            <Label x:Name="BannerTiempoLabel"
                                   Grid.Column="2"
                                   TextColor="#9A3412"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </Grid>
                    </Frame>

                    <!-- ══════════════════════════════════════
                         TARJETA FLOTANTE: PREPARACIÓN EN PROCESO
                         ══════════════════════════════════════ -->
                    <Frame x:Name="PrepFrame"
                           BackgroundColor="White"
                           CornerRadius="20"
                           Padding="16,14"
                           HasShadow="True"
                           Margin="16,-30,16,0">
                        <StackLayout Spacing="10">

                            <!-- Encabezado -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Frame Grid.Column="0"
                                       BackgroundColor="#EEF2FF"
                                       CornerRadius="12"
                                       WidthRequest="42" HeightRequest="42"
                                       Padding="0" HasShadow="False">
                                    <Image Source="hojapendiente.png"
                                           HeightRequest="22" WidthRequest="22"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Frame>
                                <Label Grid.Column="1"
                                       Text="En Proceso"
                                       FontSize="15" TextColor="#1E2235"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       Margin="10,0,0,0"/>
                                <Image Grid.Column="2"
                                       Source="refresh.png"
                                       HeightRequest="20" WidthRequest="20"
                                       VerticalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRefreshTapped"/>
                                    </Image.GestureRecognizers>
                                </Image>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F1F5F9"/>

                            <!-- Carousel de hojas pendientes -->
                            <StackLayout x:Name="HojasPendientesLayout" IsVisible="false" Spacing="6">
                                <Label Text="{Binding ResumenPendientes}"
                                       TextColor="#6B7280" FontSize="12"/>

                                <CarouselView x:Name="HojasCarousel"
                                              ItemsSource="{Binding HojasPendientes}"
                                              HeightRequest="160"
                                              PeekAreaInsets="8"
                                              Loop="False">
                                    <CarouselView.ItemTemplate>
                                        <DataTemplate>
                                            <Frame BackgroundColor="#F8FAFF"
                                                   CornerRadius="12"
                                                   Padding="14,12"
                                                   Margin="4,4"
                                                   HasShadow="False">
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnHojaTapped"/>
                                                </Frame.GestureRecognizers>
                                                <StackLayout Spacing="6">
                                                    <!-- Fila 1: Pedido + Hoja -->
                                                    <StackLayout Orientation="Horizontal" Spacing="10">
                                                        <Label Text="{Binding IdPedido, StringFormat='Pedido #{0}'}"
                                                               TextColor="#1E2235"
                                                               FontAttributes="Bold"
                                                               FontSize="14"/>
                                                        <Frame BackgroundColor="#EEF2FF"
                                                               CornerRadius="6"
                                                               Padding="7,2"
                                                               HasShadow="False">
                                                            <Label Text="{Binding NoHoja, StringFormat='Hoja {0}'}"
                                                                   TextColor="#4C51BF"
                                                                   FontSize="12"
                                                                   FontAttributes="Bold"/>
                                                        </Frame>
                                                    </StackLayout>
                                                    <!-- Fila 2: Nombre empresa -->
                                                    <Label Text="{Binding NombreEmpresa}"
                                                           TextColor="#374151"
                                                           FontSize="11"
                                                           LineBreakMode="TailTruncation"/>
                                                    <!-- Fila 3: SKUs y Fardos -->
                                                    <StackLayout Orientation="Horizontal" Spacing="8">
                                                        <Frame BackgroundColor="#F0FDF4"
                                                               CornerRadius="6" Padding="7,2"
                                                               HasShadow="False">
                                                            <Label TextColor="#065F46" FontSize="11">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{Binding TotalSkus}" FontAttributes="Bold"/>
                                                                        <Span Text=" SKUs"/>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                        </Frame>
                                                        <Frame BackgroundColor="#FFF7ED"
                                                               CornerRadius="6" Padding="7,2"
                                                               HasShadow="False">
                                                            <Label TextColor="#92400E" FontSize="11">
                                                                <Label.FormattedText>
                                                                    <FormattedString>
                                                                        <Span Text="{Binding TotalFardos}" FontAttributes="Bold"/>
                                                                        <Span Text=" Fardos"/>
                                                                    </FormattedString>
                                                                </Label.FormattedText>
                                                            </Label>
                                                        </Frame>
                                                    </StackLayout>
                                                    <!-- Barra de progreso -->
                                                    <Frame Padding="0" CornerRadius="6"
                                                           BackgroundColor="#E8ECF0"
                                                           HasShadow="False" HeightRequest="22">
                                                        <Frame HorizontalOptions="StartAndExpand"
                                                               Padding="0" CornerRadius="6"
                                                               BackgroundColor="{Binding ColorProgreso}"
                                                               WidthRequest="{Binding ProgresoWidth}">
                                                            <Label Text="{Binding PorcentajeProgreso, StringFormat='{0:F0}%'}"
                                                                   HorizontalOptions="Center"
                                                                   TextColor="White"
                                                                   FontSize="11"
                                                                   FontAttributes="Bold"
                                                                   VerticalOptions="Center"/>
                                                        </Frame>
                                                    </Frame>
                                                    <Label Text="Toca para continuar →"
                                                           TextColor="#9CA3AF"
                                                           FontSize="10"
                                                           HorizontalOptions="End"/>
                                                </StackLayout>
                                            </Frame>
                                        </DataTemplate>
                                    </CarouselView.ItemTemplate>
                                </CarouselView>

                                <IndicatorView x:Name="IndicatorView"
                                               IndicatorColor="#D1D5DB"
                                               SelectedIndicatorColor="#4C51BF"
                                               HorizontalOptions="Center"
                                               IndicatorSize="7"
                                               Margin="0,2"/>
                            </StackLayout>

                            <!-- Sin hojas pendientes -->
                            <Frame x:Name="NoHojasPendientesLabel"
                                   IsVisible="false"
                                   BackgroundColor="#F8FAFF"
                                   CornerRadius="10"
                                   Padding="14,12"
                                   HasShadow="False">
                                <StackLayout Orientation="Horizontal"
                                             HorizontalOptions="Center"
                                             Spacing="10">
                                    <Label Text="✓"
                                           TextColor="#10B981"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"/>
                                    <Label Text="Sin hojas pendientes"
                                           TextColor="#6B7280"
                                           FontSize="13"
                                           VerticalOptions="Center"/>
                                </StackLayout>
                            </Frame>
                        </StackLayout>
                    </Frame>

                    <!-- ══════════════════════════════════════
                         ACCESOS RÁPIDOS
                         ══════════════════════════════════════ -->
                    <Label Text="ACCESOS RÁPIDOS"
                           TextColor="#94A3B8"
                           FontSize="10"
                           FontAttributes="Bold"
                           CharacterSpacing="2"
                           Margin="22,20,0,4"/>

                    <!-- Contenedor blanco con scroll horizontal -->
                    <Frame x:Name="ButtonsStack"
                           BackgroundColor="White"
                           CornerRadius="20"
                           Padding="0,14"
                           HasShadow="True"
                           Margin="16,0,16,8">
                        <ScrollView Orientation="Horizontal"
                                    HorizontalScrollBarVisibility="Never">
                            <StackLayout Orientation="Horizontal"
                                         Padding="16,0" Spacing="6">

                                <!-- Gestión de Ubicaciones -->
                                <StackLayout x:Name="UbicacionesFrame"
                                             IsVisible="False"
                                             Spacing="8" WidthRequest="74">
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnUbicacionesClicked"/>
                                    </StackLayout.GestureRecognizers>
                                    <Frame BackgroundColor="#A7F3D0"
                                           CornerRadius="30"
                                           WidthRequest="60" HeightRequest="60"
                                           Padding="0" HasShadow="False"
                                           HorizontalOptions="Center">
                                        <Label Text="📍" FontSize="28"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"/>
                                    </Frame>
                                    <Label Text="Gestión&#10;Ubicaciones"
                                           TextColor="#1F2937"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           HorizontalOptions="Center"/>
                                </StackLayout>

                                <!-- Mis Pedidos -->
                                <StackLayout x:Name="MisPedidosFrame"
                                             IsVisible="False"
                                             Spacing="8" WidthRequest="74">
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMisPedidosClicked"/>
                                    </StackLayout.GestureRecognizers>
                                    <Frame BackgroundColor="#FDE68A"
                                           CornerRadius="30"
                                           WidthRequest="60" HeightRequest="60"
                                           Padding="0" HasShadow="False"
                                           HorizontalOptions="Center">
                                        <Label Text="📦" FontSize="28"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"/>
                                    </Frame>
                                    <Label Text="Mis&#10;Pedidos"
                                           TextColor="#1F2937"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           HorizontalOptions="Center"/>
                                </StackLayout>

                                <!-- Mis Chequeos -->
                                <StackLayout x:Name="MisChequeosFrame"
                                             IsVisible="False"
                                             Spacing="8" WidthRequest="74">
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMisChequeosClicked"/>
                                    </StackLayout.GestureRecognizers>
                                    <Frame BackgroundColor="#BAE6FD"
                                           CornerRadius="30"
                                           WidthRequest="60" HeightRequest="60"
                                           Padding="0" HasShadow="False"
                                           HorizontalOptions="Center">
                                        <Label Text="✅" FontSize="28"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"/>
                                    </Frame>
                                    <Label Text="Rechequeo"
                                           TextColor="#1F2937"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           HorizontalOptions="Center"/>
                                </StackLayout>

                                <!-- Embalaje -->
                                <StackLayout x:Name="EmbajajeFrame"
                                             IsVisible="False"
                                             Spacing="8" WidthRequest="74">
                                    <StackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnEmbajajeClicked"/>
                                    </StackLayout.GestureRecognizers>
                                    <Frame BackgroundColor="#FCD34D"
                                           CornerRadius="30"
                                           WidthRequest="60" HeightRequest="60"
                                           Padding="10" HasShadow="False"
                                           HorizontalOptions="Center">
                                        <Image Source="tarima.png"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>
                                    <Label Text="Embalaje"
                                           TextColor="#1F2937"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           HorizontalOptions="Center"/>
                                </StackLayout>

                            </StackLayout>
                        </ScrollView>
                    </Frame>

                    <!-- Placeholders para compatibilidad CS -->
                    <Frame x:Name="StatsGrid" IsVisible="False" HeightRequest="0"
                           Padding="0" HasShadow="False" BackgroundColor="Transparent"/>
                    <StackLayout IsVisible="False" HeightRequest="0">
                        <Frame x:Name="dummy_old" IsVisible="False" HasShadow="False" Padding="0">
                            <Label Text=" " FontSize="1" TextColor="Transparent"/>
                        </Frame>
                    </StackLayout>

                    <!-- ══════════════════════════════════════
                         CERRAR SESIÓN
                         ══════════════════════════════════════ -->
                    <StackLayout Padding="16,20,16,30" Spacing="0">
                        <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,0,0,14"/>
                        <Button Text="Cerrar Sesión"
                                BackgroundColor="White"
                                TextColor="#EF4444"
                                BorderColor="#FECACA"
                                BorderWidth="1.5"
                                CornerRadius="14"
                                HeightRequest="50"
                                FontSize="13"
                                FontAttributes="Bold"
                                Clicked="OnLogoutClicked"/>
                    </StackLayout>

                </StackLayout>
            </ScrollView>
        </RefreshView>

        <!-- ══════════════════════════════════════
             OVERLAY DE CARGA
             ══════════════════════════════════════ -->
        <Grid x:Name="LoadingOverlay"
              IsVisible="false"
              BackgroundColor="#80000000">
            <Frame BackgroundColor="White"
                   CornerRadius="20"
                   HeightRequest="104"
                   WidthRequest="104"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Padding="0"
                   HasShadow="True">
                <StackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8">
                    <ActivityIndicator IsRunning="True"
                                       Color="#4C51BF"
                                       HeightRequest="38"
                                       WidthRequest="38"
                                       HorizontalOptions="Center"/>
                    <Label Text="Cargando..."
                           TextColor="#6B7280"
                           FontSize="11"
                           HorizontalOptions="Center"/>
                </StackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>
