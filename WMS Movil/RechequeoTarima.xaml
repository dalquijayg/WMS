<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WMS_Movil.RechequeoTarima"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F1F5F9">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ══════════════════════════════════════
             HEADER
             ══════════════════════════════════════ -->
        <Grid Grid.Row="0" HeightRequest="120">
            <BoxView Color="#1E40AF"/>
            <BoxView Color="#2546B8" CornerRadius="80"
                     WidthRequest="160" HeightRequest="160"
                     HorizontalOptions="End" VerticalOptions="Start"
                     TranslationX="60" TranslationY="-60"/>
            <BoxView Color="#1836A0" CornerRadius="50"
                     WidthRequest="100" HeightRequest="100"
                     HorizontalOptions="Start" VerticalOptions="End"
                     TranslationX="-30" TranslationY="35"/>

            <Grid ColumnDefinitions="Auto,*,Auto"
                  Padding="16,0" VerticalOptions="Center"
                  Margin="0,16,0,0">
                <Frame Grid.Column="0"
                       BackgroundColor="#1836A0" CornerRadius="12"
                       WidthRequest="38" HeightRequest="38"
                       Padding="0" HasShadow="False">
                    <Label Text="←" TextColor="White" FontSize="18"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBackClicked"/>
                        </Label.GestureRecognizers>
                    </Label>
                </Frame>

                <StackLayout Grid.Column="1" HorizontalOptions="Center"
                             VerticalOptions="Center" Spacing="2">
                    <Label Text="Rechequeo de Tarima" TextColor="White"
                           FontSize="17" FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                    <Label Text="Verificación física de productos"
                           TextColor="#BFDBFE" FontSize="11"
                           HorizontalTextAlignment="Center"/>
                </StackLayout>

                <Frame Grid.Column="2"
                       BackgroundColor="#FCD34D" CornerRadius="12"
                       WidthRequest="38" HeightRequest="38"
                       Padding="6" HasShadow="False">
                    <Image Source="tarima.png"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Frame>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════
             CONTENIDO
             ══════════════════════════════════════ -->
        <ScrollView Grid.Row="1">
            <StackLayout Padding="16,14" Spacing="12">

                <!-- ── PANEL 1: Escanear tarima ── -->
                <Frame x:Name="PanelScanTarima"
                       BackgroundColor="White" CornerRadius="16"
                       Padding="16" HasShadow="True">
                    <StackLayout Spacing="12">
                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Frame BackgroundColor="#DBEAFE" CornerRadius="10"
                                   WidthRequest="36" HeightRequest="36"
                                   Padding="0" HasShadow="False">
                                <Label Text="🔍" FontSize="18"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                            </Frame>
                            <StackLayout Spacing="1" VerticalOptions="Center">
                                <Label Text="TARIMA A RECHEQUEAR"
                                       TextColor="#1E40AF" FontSize="11"
                                       FontAttributes="Bold" CharacterSpacing="1"/>
                                <Label Text="Escanea el QR de la tarima a verificar"
                                       TextColor="#9CA3AF" FontSize="11"/>
                            </StackLayout>
                        </StackLayout>

                        <Frame BackgroundColor="#EFF6FF" CornerRadius="12"
                               Padding="12,10" HasShadow="False"
                               BorderColor="#BFDBFE">
                            <Entry x:Name="QrTarimaEntry"
                                   Placeholder="Escanear QR de la tarima..."
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="#1F2937" FontSize="14"
                                   Keyboard="Numeric" ReturnType="Done"
                                   Completed="OnQrTarimaCompleted"/>
                        </Frame>

                        <Button Text="Buscar tarima"
                                BackgroundColor="#1E40AF" TextColor="White"
                                CornerRadius="12" HeightRequest="44"
                                FontSize="13" FontAttributes="Bold"
                                Clicked="OnBuscarTarimaClicked"/>
                    </StackLayout>
                </Frame>

                <!-- ── PANEL 2: Info tarima activa ── -->
                <Frame x:Name="PanelInfoTarima"
                       IsVisible="False"
                       BackgroundColor="#DBEAFE" CornerRadius="14"
                       Padding="14,12" HasShadow="False">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Frame Grid.Column="0"
                               BackgroundColor="#1E40AF" CornerRadius="10"
                               WidthRequest="34" HeightRequest="34"
                               Padding="6" HasShadow="False">
                            <Image Source="tarima.png"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Frame>
                        <StackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label x:Name="InfoTarimaLabel"
                                   TextColor="#1E3A8A" FontSize="12"
                                   FontAttributes="Bold"/>
                            <Label Text="Rechequeo en progreso"
                                   TextColor="#3B82F6" FontSize="10"/>
                        </StackLayout>
                        <Label Grid.Column="2" Text="✕"
                               TextColor="#3B82F6" FontSize="18"
                               VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCancelarClicked"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Frame>

                <!-- ── PANEL 3: Lista de productos + escaneo ── -->
                <Frame x:Name="PanelProductos"
                       IsVisible="False"
                       BackgroundColor="White" CornerRadius="16"
                       Padding="16" HasShadow="True">
                    <StackLayout Spacing="12">

                        <!-- Contador -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Productos de la tarima"
                                       TextColor="#1F2937" FontSize="14"
                                       FontAttributes="Bold"/>
                                <Label x:Name="ContadorLabel"
                                       TextColor="#6B7280" FontSize="12"/>
                            </StackLayout>
                            <Frame Grid.Column="1"
                                   x:Name="ContadorFrame"
                                   BackgroundColor="#FEF3C7" CornerRadius="8"
                                   Padding="10,4" HasShadow="False">
                                <Label x:Name="ContadorBadge"
                                       TextColor="#D97706" FontSize="12"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                            </Frame>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F1F5F9"/>

                        <!-- Leyenda de estados -->
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <StackLayout Orientation="Horizontal" Spacing="4">
                                <Label Text="○" TextColor="#9CA3AF" FontSize="13"/>
                                <Label Text="Pendiente" TextColor="#9CA3AF" FontSize="11"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="4">
                                <Label Text="✅" FontSize="13"/>
                                <Label Text="Chequeado" TextColor="#059669" FontSize="11"/>
                            </StackLayout>
                            <StackLayout Orientation="Horizontal" Spacing="4">
                                <Label Text="🔄" FontSize="13"/>
                                <Label Text="Traslado" TextColor="#D97706" FontSize="11"/>
                            </StackLayout>
                        </StackLayout>

                        <!-- Campo escaneo UPC -->
                        <StackLayout Spacing="6">
                            <Label Text="ESCANEAR PRODUCTO"
                                   TextColor="#6B7280" FontSize="10"
                                   FontAttributes="Bold" CharacterSpacing="1"/>
                            <Frame x:Name="UpcFrame"
                                   BackgroundColor="#EFF6FF" CornerRadius="12"
                                   Padding="12,10" HasShadow="False"
                                   BorderColor="#BFDBFE">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Grid.Column="0" Text="📷"
                                           FontSize="16" VerticalOptions="Center"/>
                                    <Entry Grid.Column="1"
                                           x:Name="UpcEntry"
                                           Placeholder="Escanear UPC..."
                                           PlaceholderColor="#9CA3AF"
                                           TextColor="#1F2937" FontSize="13"
                                           ReturnType="Done"
                                           Completed="OnUpcCompleted"/>
                                </Grid>
                            </Frame>
                        </StackLayout>

                        <!-- Lista dinámica -->
                        <StackLayout x:Name="ProductosLayout" Spacing="6"/>

                    </StackLayout>
                </Frame>

            </StackLayout>
        </ScrollView>

        <!-- ══════════════════════════════════════
             BARRA INFERIOR FIJA
             ══════════════════════════════════════ -->
        <StackLayout Grid.Row="2" x:Name="BottomArea"
                     IsVisible="False" Spacing="0"
                     BackgroundColor="#F1F5F9">
            <BoxView HeightRequest="1" Color="#E2E8F0"/>

            <!-- Progreso (mientras faltan productos) -->
            <Frame x:Name="PanelProgreso"
                   IsVisible="False"
                   BackgroundColor="White" CornerRadius="0"
                   Padding="16,12" HasShadow="False">
                <StackLayout Orientation="Horizontal" Spacing="12"
                             HorizontalOptions="Center">
                    <Label Text="⏳" FontSize="18" VerticalOptions="Center"/>
                    <Label x:Name="ProgresoLabel"
                           TextColor="#6B7280" FontSize="13"
                           VerticalOptions="Center"/>
                </StackLayout>
            </Frame>

            <!-- Finalizar sin traslados -->
            <Frame x:Name="PanelFinalizarSin"
                   IsVisible="False"
                   BackgroundColor="White" CornerRadius="0"
                   Padding="16,12" HasShadow="False">
                <Button Text="✔  Finalizar Rechequeo"
                        BackgroundColor="#059669" TextColor="White"
                        CornerRadius="12" HeightRequest="48"
                        FontSize="14" FontAttributes="Bold"
                        Clicked="OnFinalizarClicked"/>
            </Frame>

            <!-- Finalizar con traslados → pide destino -->
            <Frame x:Name="PanelFinalizarCon"
                   IsVisible="False"
                   BackgroundColor="White" CornerRadius="0"
                   Padding="16,12" HasShadow="False">
                <StackLayout Spacing="10">
                    <Frame BackgroundColor="#FEF3C7" CornerRadius="10"
                           Padding="12,8" HasShadow="False">
                        <StackLayout Orientation="Horizontal" Spacing="8">
                            <Label Text="🔄" FontSize="16" VerticalOptions="Center"/>
                            <Label x:Name="ResumenTrasladoLabel"
                                   TextColor="#92400E" FontSize="12"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Frame>
                    <Button Text="Siguiente: escanear tarima destino →"
                            BackgroundColor="#D97706" TextColor="White"
                            CornerRadius="12" HeightRequest="48"
                            FontSize="13" FontAttributes="Bold"
                            Clicked="OnIrADestinoClicked"/>
                </StackLayout>
            </Frame>

            <!-- Scan tarima destino -->
            <Frame x:Name="PanelScanDestino"
                   IsVisible="False"
                   BackgroundColor="White" CornerRadius="0"
                   Padding="16,14" HasShadow="False">
                <StackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Frame Grid.Column="0"
                               BackgroundColor="#FEF3C7" CornerRadius="10"
                               WidthRequest="36" HeightRequest="36"
                               Padding="0" HasShadow="False">
                            <Label Text="📤" FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                        </Frame>
                        <StackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="TARIMA DESTINO PARA TRASLADOS"
                                   TextColor="#D97706" FontSize="10"
                                   FontAttributes="Bold" CharacterSpacing="1"/>
                            <Label Text="Escanea el QR de la tarima receptora"
                                   TextColor="#9CA3AF" FontSize="10"/>
                        </StackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Frame Grid.Column="0"
                               BackgroundColor="#FFFBEB" CornerRadius="12"
                               Padding="12,8" HasShadow="False"
                               BorderColor="#FDE68A">
                            <Entry x:Name="QrDestinoEntry"
                                   Placeholder="Escanear QR tarima destino..."
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="#1F2937" FontSize="13"
                                   Keyboard="Numeric" ReturnType="Done"
                                   Completed="OnQrDestinoCompleted"/>
                        </Frame>
                        <Button Grid.Column="1" Text="OK"
                                BackgroundColor="#D97706" TextColor="White"
                                CornerRadius="12" HeightRequest="42"
                                WidthRequest="56" FontSize="13" FontAttributes="Bold"
                                Clicked="OnBuscarDestinoClicked"/>
                    </Grid>
                </StackLayout>
            </Frame>

            <!-- Confirmación final -->
            <Frame x:Name="PanelConfirmarFinal"
                   IsVisible="False"
                   BackgroundColor="White" CornerRadius="0"
                   Padding="16,14" HasShadow="False">
                <StackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                        <Frame Grid.Column="0"
                               BackgroundColor="#DBEAFE" CornerRadius="10"
                               Padding="10,8" HasShadow="False">
                            <StackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="ORIGEN" TextColor="#1E40AF"
                                       FontSize="9" FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       CharacterSpacing="1"/>
                                <Label x:Name="BadgeOrigenLabel"
                                       TextColor="#1E3A8A" FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"/>
                            </StackLayout>
                        </Frame>
                        <Label Grid.Column="1" Text="→" FontSize="20"
                               TextColor="#6B7280" VerticalOptions="Center"
                               HorizontalOptions="Center"/>
                        <Frame Grid.Column="2"
                               BackgroundColor="#FEF3C7" CornerRadius="10"
                               Padding="10,8" HasShadow="False">
                            <StackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="DESTINO" TextColor="#D97706"
                                       FontSize="9" FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       CharacterSpacing="1"/>
                                <Label x:Name="BadgeDestinoLabel"
                                       TextColor="#92400E" FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"/>
                            </StackLayout>
                        </Frame>
                    </Grid>
                    <Label x:Name="ResumenFinalLabel"
                           TextColor="#6B7280" FontSize="11"
                           HorizontalTextAlignment="Center"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="✕"
                                BackgroundColor="Transparent" TextColor="#6B7280"
                                BorderColor="#E5E7EB" BorderWidth="1"
                                CornerRadius="12" HeightRequest="46"
                                WidthRequest="46" FontSize="16"
                                Clicked="OnCambiarDestinoClicked"/>
                        <Button Grid.Column="1"
                                Text="✔  Confirmar todo"
                                BackgroundColor="#059669" TextColor="White"
                                CornerRadius="12" HeightRequest="46"
                                FontSize="13" FontAttributes="Bold"
                                Clicked="OnConfirmarTodoClicked"/>
                    </Grid>
                </StackLayout>
            </Frame>

        </StackLayout>

    </Grid>
</ContentPage>
