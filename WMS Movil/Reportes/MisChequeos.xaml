<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WMS_Movil.Reportes.MisChequeos"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#f8f9fa">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Frame Grid.Row="0" 
               BackgroundColor="#2d3748" 
               CornerRadius="0" 
               Padding="15,12" 
               Margin="0"
               HasShadow="False">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Text="⬅"
                        BackgroundColor="#4a5568"
                        TextColor="White"
                        CornerRadius="12"
                        HeightRequest="32"
                        WidthRequest="32"
                        FontSize="14"
                        Padding="0"
                        Clicked="OnBackClicked"/>

                <StackLayout Grid.Column="1" 
                             VerticalOptions="Center" 
                             HorizontalOptions="Center"
                             Spacing="2">
                    <Label Text="Mis Chequeos Realizados"
                           TextColor="White"
                           FontSize="16"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>
                    <Label x:Name="SubtitleLabel"
                           Text="Historial de rechequeos"
                           TextColor="#cbd5e0"
                           FontSize="11"
                           HorizontalOptions="Center"/>
                </StackLayout>

                <Image Grid.Column="2"
                       Source="refresh.png"
                       HeightRequest="24"
                       WidthRequest="24"
                       VerticalOptions="Center">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRefreshClicked"/>
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </Frame>

        <!-- Estadísticas -->
        <Frame Grid.Row="1"
               BackgroundColor="White"
               CornerRadius="0"
               Padding="12,10"
               Margin="0"
               HasShadow="True">
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="6">
                <!-- Total Tarimas -->
                <Frame Grid.Column="0"
                       BackgroundColor="#EDF2F7"
                       CornerRadius="8"
                       Padding="6,5"
                       HasShadow="False">
                    <StackLayout Spacing="1">
                        <Label Text="Tarimas"
                               FontSize="9"
                               TextColor="#718096"
                               HorizontalOptions="Center"/>
                        <Label x:Name="TotalLabel"
                               Text="0"
                               TextColor="#4c51bf"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Frame>

                <!-- Total SKUs -->
                <Frame Grid.Column="1"
                       BackgroundColor="#F0FFF4"
                       CornerRadius="8"
                       Padding="6,5"
                       HasShadow="False">
                    <StackLayout Spacing="1">
                        <Label Text="SKUs"
                               FontSize="9"
                               TextColor="#718096"
                               HorizontalOptions="Center"/>
                        <Label x:Name="SkusLabel"
                               Text="0"
                               TextColor="#48BB78"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Frame>

                <!-- Total Fardos -->
                <Frame Grid.Column="2"
                       BackgroundColor="#FFF5F5"
                       CornerRadius="8"
                       Padding="6,5"
                       HasShadow="False">
                    <StackLayout Spacing="1">
                        <Label Text="Fardos"
                               FontSize="9"
                               TextColor="#718096"
                               HorizontalOptions="Center"/>
                        <Label x:Name="FardosLabel"
                               Text="0"
                               TextColor="#E53E3E"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Frame>

                <!-- Total Inventarios -->
                <Frame Grid.Column="3"
                       BackgroundColor="#FFFAF0"
                       CornerRadius="8"
                       Padding="6,5"
                       HasShadow="False">
                    <StackLayout Spacing="1">
                        <Label Text="Inv."
                               FontSize="9"
                               TextColor="#718096"
                               HorizontalOptions="Center"/>
                        <Label x:Name="InventariosLabel"
                               Text="0"
                               TextColor="#DD6B20"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                </Frame>
            </Grid>
        </Frame>

        <!-- Lista de chequeos -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     RefreshColor="#4c51bf"
                     Command="{Binding RefreshCommand}">
            <ScrollView>
                <StackLayout Padding="12,8">
                    <!-- Mensaje cuando no hay datos -->
                    <Frame x:Name="EmptyFrame"
                           IsVisible="False"
                           BackgroundColor="White"
                           CornerRadius="10"
                           Padding="20"
                           HasShadow="True"
                           Margin="0,40,0,0">
                        <StackLayout Spacing="12" HorizontalOptions="Center">
                            <Image Source="info.png"
                                   HeightRequest="50"
                                   Aspect="AspectFit"/>
                            <Label Text="No hay chequeos realizados hoy"
                                   TextColor="#4a5568"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"/>
                            <Label Text="Las tarimas que chequees hoy aparecerán aquí"
                                   TextColor="#718096"
                                   FontSize="13"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </Frame>

                    <!-- CollectionView de chequeos -->
                    <CollectionView x:Name="ChequeosCollection"
                                   SelectionMode="Single"
                                   SelectionChanged="OnChequeoSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="0,0,0,10"
                                       CornerRadius="10"
                                       BackgroundColor="White"
                                       HasShadow="True"
                                       Padding="12">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Fila 1: Header con Pedido y Tarima -->
                                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                            <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="10">
                                                <Label Text="{Binding IdPedido, StringFormat='Pedido #{0}'}"
                                                       TextColor="#2d3748"
                                                       FontAttributes="Bold"
                                                       FontSize="15"/>
                                                <Label Text="{Binding NoTarima, StringFormat='Tarima {0}'}"
                                                       TextColor="#48BB78"
                                                       FontAttributes="Bold"
                                                       FontSize="15"/>
                                            </StackLayout>

                                            <Frame Grid.Column="1"
                                                   BackgroundColor="#4c51bf"
                                                   CornerRadius="8"
                                                   Padding="6,3"
                                                   HasShadow="False">
                                                <Label Text="{Binding IdInventario, StringFormat='Inv. #{0}'}"
                                                       TextColor="White"
                                                       FontSize="10"
                                                       FontAttributes="Bold"/>
                                            </Frame>
                                        </Grid>

                                        <!-- Fila 2: Información -->
                                        <StackLayout Grid.Row="1" Spacing="3">
                                            <Label Text="{Binding NombreEmpresa, StringFormat='🏢 {0}'}"
                                                   TextColor="#4a5568"
                                                   FontSize="12"
                                                   LineBreakMode="TailTruncation"/>
                                            <Label Text="{Binding TiempoTranscurrido, StringFormat='⏱ Duración: {0}'}"
                                                   TextColor="#718096"
                                                   FontSize="11"/>
                                        </StackLayout>

                                        <!-- Separador -->
                                        <BoxView Grid.Row="2" 
                                                 HeightRequest="1" 
                                                 BackgroundColor="#e2e8f0"/>

                                        <!-- Fila 3: Estadísticas -->
                                        <Grid Grid.Row="3" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                            <Frame Grid.Column="0"
                                                   BackgroundColor="#EDF2F7"
                                                   CornerRadius="6"
                                                   Padding="6,4"
                                                   HasShadow="False">
                                                <StackLayout Spacing="1">
                                                    <Label Text="Inicio"
                                                           FontSize="9"
                                                           TextColor="#718096"
                                                           HorizontalOptions="Center"/>
                                                    <Label Text="{Binding HoraInicio}"
                                                           TextColor="#4c51bf"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center"/>
                                                </StackLayout>
                                            </Frame>

                                            <Frame Grid.Column="1"
                                                   BackgroundColor="#F0FFF4"
                                                   CornerRadius="6"
                                                   Padding="6,4"
                                                   HasShadow="False">
                                                <StackLayout Spacing="1">
                                                    <Label Text="SKUs"
                                                           FontSize="9"
                                                           TextColor="#718096"
                                                           HorizontalOptions="Center"/>
                                                    <Label Text="{Binding CantidadSkus}"
                                                           TextColor="#48BB78"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center"/>
                                                </StackLayout>
                                            </Frame>

                                            <Frame Grid.Column="2"
                                                   BackgroundColor="#FFF5F5"
                                                   CornerRadius="6"
                                                   Padding="6,4"
                                                   HasShadow="False">
                                                <StackLayout Spacing="1">
                                                    <Label Text="Fardos"
                                                           FontSize="9"
                                                           TextColor="#718096"
                                                           HorizontalOptions="Center"/>
                                                    <Label Text="{Binding CantidadFardos}"
                                                           TextColor="#E53E3E"
                                                           FontSize="14"
                                                           FontAttributes="Bold"
                                                           HorizontalOptions="Center"/>
                                                </StackLayout>
                                            </Frame>
                                        </Grid>
                                    </Grid>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" 
              IsVisible="False"
              BackgroundColor="#80000000"
              Grid.RowSpan="3">
            <Frame BackgroundColor="White"
                   CornerRadius="10"
                   HeightRequest="90"
                   WidthRequest="90"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <StackLayout Spacing="8">
                    <ActivityIndicator IsRunning="True"
                                       Color="#4c51bf"
                                       HeightRequest="40"
                                       WidthRequest="40"/>
                    <Label Text="Cargando..."
                           TextColor="#2d3748"
                           FontSize="12"
                           HorizontalOptions="Center"/>
                </StackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>