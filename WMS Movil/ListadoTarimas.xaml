<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WMS_Movil.ListadoTarimas"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F1F5F9">

    <Grid>
        <ScrollView>
            <StackLayout Spacing="0">

                <!-- ══════════════════════════════════════
                     HEADER HERO
                     ══════════════════════════════════════ -->
                <Grid HeightRequest="164">
                    <!-- Fondo base -->
                    <BoxView Color="#4C51BF"/>
                    <!-- Círculo decorativo superior derecho -->
                    <BoxView Color="#5558C8"
                             CornerRadius="100"
                             WidthRequest="200" HeightRequest="200"
                             HorizontalOptions="End" VerticalOptions="Start"
                             TranslationX="75" TranslationY="-75"/>
                    <!-- Círculo decorativo inferior izquierdo -->
                    <BoxView Color="#3D42B0"
                             CornerRadius="60"
                             WidthRequest="120" HeightRequest="120"
                             HorizontalOptions="Start" VerticalOptions="End"
                             TranslationX="-40" TranslationY="45"/>

                    <!-- Contenido del header -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          Padding="16,0"
                          VerticalOptions="Center"
                          Margin="0,20,0,0">
                        <Frame Grid.Column="0"
                               BackgroundColor="#3B3FA0"
                               CornerRadius="12"
                               WidthRequest="38" HeightRequest="38"
                               Padding="0" HasShadow="False">
                            <Label Text="←" TextColor="White" FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBackButtonClicked"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Frame>

                        <StackLayout Grid.Column="1"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="2">
                            <Label Text="Tarimas del Pedido"
                                   TextColor="White"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                            <Label x:Name="PedidoLabel"
                                   Text="Pedido #0"
                                   TextColor="#C7D2FE"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center"/>
                            <Label x:Name="EmpresaDepartamentoLabel"
                                   IsVisible="False"
                                   TextColor="#A5B4FC"
                                   FontSize="11"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"/>
                        </StackLayout>

                        <Frame Grid.Column="2"
                               BackgroundColor="#3B3FA0"
                               CornerRadius="12"
                               WidthRequest="38" HeightRequest="38"
                               Padding="7" HasShadow="False">
                            <Label Text="📦" FontSize="16"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                        </Frame>
                    </Grid>
                </Grid>

                <!-- ══════════════════════════════════════
                     CONTENIDO
                     ══════════════════════════════════════ -->
                <StackLayout Padding="16,16,16,10" Spacing="14">

                    <!-- Banner: tarima en proceso -->
                    <Frame x:Name="MensajeActivoFrame"
                           IsVisible="False"
                           BackgroundColor="#FFF7ED"
                           BorderColor="#FDBA74"
                           CornerRadius="16"
                           Padding="14,12"
                           HasShadow="True">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Frame Grid.Column="0"
                                   BackgroundColor="#FED7AA"
                                   CornerRadius="10"
                                   WidthRequest="40" HeightRequest="40"
                                   Padding="0" HasShadow="False">
                                <Label Text="⏰" FontSize="20"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                            </Frame>
                            <StackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label x:Name="MensajeActivoLabel"
                                       TextColor="#9A3412"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"/>
                                <Label Text="Debe completar la tarima actual antes de iniciar otra."
                                       TextColor="#C2410C"
                                       FontSize="11"
                                       LineBreakMode="TailTruncation"/>
                            </StackLayout>
                        </Grid>
                    </Frame>

                    <Label Text="TARIMAS PENDIENTES"
                           TextColor="#94A3B8"
                           FontSize="10"
                           FontAttributes="Bold"
                           CharacterSpacing="2"
                           Margin="4,0,0,-4"/>

                    <!-- Lista de tarimas -->
                    <CollectionView x:Name="TarimasCollection"
                                    SelectionMode="Single"
                                    SelectionChanged="OnTarimaSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="0,0,0,4"
                                       CornerRadius="16"
                                       BackgroundColor="White"
                                       HasShadow="True"
                                       Padding="16,14">
                                    <StackLayout Spacing="10">

                                        <!-- Fila 1: ícono + número + estado -->
                                        <Grid ColumnDefinitions="Auto,*">
                                            <Frame Grid.Column="0"
                                                   BackgroundColor="#EEF2FF"
                                                   CornerRadius="12"
                                                   WidthRequest="42" HeightRequest="42"
                                                   Padding="0" HasShadow="False">
                                                <Label Text="{Binding IconoEstado}"
                                                       FontSize="20"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"/>
                                            </Frame>
                                            <StackLayout Grid.Column="1"
                                                         Spacing="1"
                                                         VerticalOptions="Center"
                                                         Margin="10,0,0,0">
                                                <Label Text="{Binding NumeroTarima, StringFormat='Tarima #{0}'}"
                                                       TextColor="#1E2235"
                                                       FontSize="15"
                                                       FontAttributes="Bold"/>
                                                <Label Text="{Binding EstadoTexto}"
                                                       TextColor="{Binding ColorEstado}"
                                                       FontSize="11"
                                                       FontAttributes="Bold"/>
                                            </StackLayout>
                                        </Grid>

                                        <!-- Barra de progreso -->
                                        <Frame Padding="0" CornerRadius="6"
                                               BackgroundColor="#E8ECF0"
                                               HasShadow="False" HeightRequest="20">
                                            <Frame HorizontalOptions="StartAndExpand"
                                                   Padding="0" CornerRadius="6"
                                                   BackgroundColor="{Binding ColorProgreso}"
                                                   WidthRequest="{Binding ProgresoWidth}">
                                                <Label Text="{Binding PorcentajeProgreso, StringFormat='{0:F0}%'}"
                                                       HorizontalOptions="Center"
                                                       TextColor="White"
                                                       FontSize="10"
                                                       FontAttributes="Bold"
                                                       VerticalOptions="Center"/>
                                            </Frame>
                                        </Frame>

                                        <!-- Chips: SKUs / verificados / fardos -->
                                        <StackLayout Orientation="Horizontal" Spacing="8">
                                            <Frame BackgroundColor="#EEF2FF"
                                                   CornerRadius="6" Padding="8,3"
                                                   HasShadow="False">
                                                <Label TextColor="#4C51BF" FontSize="11">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding TotalProductos}" FontAttributes="Bold"/>
                                                            <Span Text=" SKUs"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Frame>
                                            <Frame BackgroundColor="#F0FDF4"
                                                   CornerRadius="6" Padding="8,3"
                                                   HasShadow="False">
                                                <Label TextColor="#065F46" FontSize="11">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding ProductosVerificados}" FontAttributes="Bold"/>
                                                            <Span Text=" verificados"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Frame>
                                            <Frame BackgroundColor="#FFF7ED"
                                                   CornerRadius="6" Padding="8,3"
                                                   HasShadow="False">
                                                <Label TextColor="#92400E" FontSize="11">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding TotalFardos}" FontAttributes="Bold"/>
                                                            <Span Text=" Fardos"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Frame>
                                        </StackLayout>

                                        <!-- Inventario -->
                                        <Label Text="{Binding TextoInventario}"
                                               TextColor="#9CA3AF"
                                               FontSize="11"/>

                                        <!-- Quién preparó la tarima -->
                                        <Label Text="{Binding TextoPreparador}"
                                               TextColor="#9CA3AF"
                                               FontSize="11"
                                               IsVisible="{Binding TienePreparador}"/>

                                        <!-- Usuario asignado al rechequeo (si existe) -->
                                        <Label Text="{Binding TextoUsuario}"
                                               TextColor="#9CA3AF"
                                               FontSize="11"
                                               IsVisible="{Binding TieneUsuarioAsignado}"/>

                                        <Label Text="Toca para continuar →"
                                               TextColor="#9CA3AF"
                                               FontSize="10"
                                               HorizontalOptions="End"/>
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Sin tarimas pendientes -->
                    <Frame x:Name="SinTarimasFrame"
                           IsVisible="False"
                           BackgroundColor="#F8FAFF"
                           CornerRadius="14"
                           Padding="14,12"
                           HasShadow="False">
                        <StackLayout Orientation="Horizontal"
                                     HorizontalOptions="Center"
                                     Spacing="10">
                            <Label Text="✓"
                                   TextColor="#10B981"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                            <Label Text="Este pedido no tiene tarimas pendientes de rechequeo"
                                   TextColor="#6B7280"
                                   FontSize="13"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Frame>

                </StackLayout>

            </StackLayout>
        </ScrollView>

        <!-- ══════════════════════════════════════
             OVERLAY DE CARGA
             ══════════════════════════════════════ -->
        <Grid x:Name="LoadingOverlay"
              IsVisible="false"
              BackgroundColor="#80000000">
            <Frame BackgroundColor="White"
                   CornerRadius="20"
                   HeightRequest="104"
                   WidthRequest="104"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Padding="0"
                   HasShadow="True">
                <StackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8">
                    <ActivityIndicator IsRunning="True"
                                       Color="#4C51BF"
                                       HeightRequest="38"
                                       WidthRequest="38"
                                       HorizontalOptions="Center"/>
                    <Label Text="Cargando..."
                           TextColor="#6B7280"
                           FontSize="11"
                           HorizontalOptions="Center"/>
                </StackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>
