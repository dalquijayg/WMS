<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WMS_Movil.RegistrarInventarioUbicacion"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F1F5F9">

    <AbsoluteLayout>

        <Grid AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              RowDefinitions="Auto,*">

            <!-- ══════════════════════════════════════
                 HERO: nav + ubicación + scanner
                 ══════════════════════════════════════ -->
            <Grid Grid.Row="0">
                <BoxView Color="#4C51BF"/>
                <BoxView Color="#5558C8" CornerRadius="80"
                         WidthRequest="160" HeightRequest="160"
                         HorizontalOptions="End" VerticalOptions="Start"
                         TranslationX="60" TranslationY="-60"/>
                <BoxView Color="#3D42B0" CornerRadius="45"
                         WidthRequest="90" HeightRequest="90"
                         HorizontalOptions="Start" VerticalOptions="End"
                         TranslationX="-30" TranslationY="30"/>

                <StackLayout Padding="0,6,0,18" Spacing="10">

                    <!-- Barra de navegación -->
                    <Grid ColumnDefinitions="Auto,*" Padding="4,4,16,0">
                        <Button Grid.Column="0"
                                Text="←"
                                TextColor="White"
                                BackgroundColor="Transparent"
                                FontSize="22"
                                WidthRequest="44" HeightRequest="44"
                                Padding="0"
                                Clicked="OnVolverClicked"/>
                        <StackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="Registrar Producto"
                                   TextColor="White"
                                   FontSize="16"
                                   FontAttributes="Bold"/>
                            <Label x:Name="HeaderSubtituloLabel"
                                   Text="Escanee el QR de la ubicación"
                                   TextColor="#C7D2FE"
                                   FontSize="11"/>
                        </StackLayout>
                    </Grid>

                    <!-- Panel sin ubicación -->
                    <Frame x:Name="PanelSinUbicacion"
                           BackgroundColor="#3B3FA0"
                           CornerRadius="14"
                           Padding="14,12"
                           HasShadow="False"
                           Margin="16,0">
                        <StackLayout Orientation="Horizontal" Spacing="12">
                            <Frame BackgroundColor="#4C51BF"
                                   CornerRadius="10"
                                   WidthRequest="40" HeightRequest="40"
                                   Padding="0" HasShadow="False">
                                <Label Text="📷" FontSize="18"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                            </Frame>
                            <StackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Sin ubicación seleccionada"
                                       TextColor="White"
                                       FontSize="13"
                                       FontAttributes="Bold"/>
                                <Label Text="Escanee el código QR del rack"
                                       TextColor="#A5B4FC"
                                       FontSize="11"/>
                            </StackLayout>
                        </StackLayout>
                    </Frame>

                    <!-- Panel con ubicación -->
                    <Frame x:Name="PanelUbicacion"
                           IsVisible="False"
                           BackgroundColor="#3B3FA0"
                           CornerRadius="14"
                           Padding="16,12"
                           HasShadow="False"
                           Margin="16,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackLayout Grid.Column="0" Spacing="3">
                                <Label x:Name="UbicacionCodigoLabel"
                                       Text="P01-R01-B01-N01"
                                       TextColor="White"
                                       FontSize="18"
                                       FontAttributes="Bold"/>
                                <Label x:Name="UbicacionDetalleLabel"
                                       Text="Pasillo 1 · Rack 1 · Bloque 1 · Nivel 1"
                                       TextColor="#A5B4FC"
                                       FontSize="11"/>
                            </StackLayout>
                            <Button Grid.Column="1"
                                    Text="Cambiar"
                                    TextColor="#4C51BF"
                                    BackgroundColor="White"
                                    CornerRadius="8"
                                    FontSize="11"
                                    FontAttributes="Bold"
                                    Padding="12,6"
                                    HeightRequest="34"
                                    VerticalOptions="Center"
                                    Clicked="OnCambiarUbicacionClicked"/>
                        </Grid>
                    </Frame>

                    <!-- Campo de escaneo -->
                    <Frame BackgroundColor="White"
                           CornerRadius="14"
                           Padding="14,8"
                           HasShadow="False"
                           Margin="16,0">
                        <Grid ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0"
                                   Text="⌕"
                                   FontSize="22"
                                   TextColor="#9CA3AF"
                                   VerticalOptions="Center"
                                   Margin="0,0,8,0"/>
                            <Entry Grid.Column="1"
                                   x:Name="EntradaEntry"
                                   Placeholder="Escanee el QR de la ubicación"
                                   TextColor="#1E2235"
                                   PlaceholderColor="#9CA3AF"
                                   FontSize="14"
                                   HeightRequest="40"
                                   ReturnType="Done"
                                   Completed="OnEntradaCompleted"/>
                        </Grid>
                    </Frame>

                </StackLayout>
            </Grid>

            <!-- ══════════════════════════════════════
                 CONTENIDO DESPLAZABLE
                 ══════════════════════════════════════ -->
            <ScrollView Grid.Row="1">
                <StackLayout Spacing="0" Padding="0,0,0,24">

                    <!-- Tarjeta flotante: producto encontrado -->
                    <Frame x:Name="PanelProducto"
                           IsVisible="False"
                           BackgroundColor="White"
                           CornerRadius="20"
                           Padding="18,16"
                           Margin="16,14,16,0"
                           HasShadow="True">
                        <StackLayout Spacing="14">

                            <!-- Encabezado producto -->
                            <StackLayout Spacing="6">
                                <Label Text="PRODUCTO ENCONTRADO"
                                       TextColor="#9CA3AF"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.2"/>
                                <Label x:Name="ProductoDescLabel"
                                       Text=""
                                       TextColor="#111827"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       LineBreakMode="WordWrap"/>
                                <!-- UpcLabel oculto, solo para compatibilidad CS -->
                                <Label x:Name="ProductoUpcLabel"
                                       Text=""
                                       IsVisible="False"
                                       FontSize="1"/>
                            </StackLayout>

                            <!-- Info de paquete -->
                            <Frame x:Name="PanelPaquete"
                                   IsVisible="False"
                                   BackgroundColor="#F8FAFF"
                                   CornerRadius="12"
                                   Padding="14,12"
                                   HasShadow="False">
                                <StackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <StackLayout Grid.Column="0" Spacing="3">
                                            <Label Text="UPC"
                                                   TextColor="#9CA3AF"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   CharacterSpacing="0.8"/>
                                            <Label x:Name="UpcPaqueteLabel"
                                                   Text=""
                                                   TextColor="#4C51BF"
                                                   FontSize="12"
                                                   FontAttributes="Bold"/>
                                        </StackLayout>
                                        <StackLayout Grid.Column="1" Spacing="3">
                                            <Label Text="UPC PAQUETE"
                                                   TextColor="#9CA3AF"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   CharacterSpacing="0.8"/>
                                            <Label x:Name="CodigoPaqueteLabel"
                                                   Text=""
                                                   TextColor="#4C51BF"
                                                   FontSize="12"
                                                   FontAttributes="Bold"/>
                                        </StackLayout>
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="#E8ECFF"/>
                                    <StackLayout Orientation="Horizontal" Spacing="10" VerticalOptions="Center">
                                        <Label Text="Unidades por paquete:"
                                               TextColor="#6B7280"
                                               FontSize="12"
                                               VerticalOptions="Center"/>
                                        <Frame BackgroundColor="#4C51BF"
                                               CornerRadius="8"
                                               Padding="12,4"
                                               HasShadow="False">
                                            <Label x:Name="CantidadPaqueteLabel"
                                                   Text=""
                                                   TextColor="White"
                                                   FontSize="14"
                                                   FontAttributes="Bold"/>
                                        </Frame>
                                    </StackLayout>
                                </StackLayout>
                            </Frame>

                            <BoxView HeightRequest="1" Color="#F1F5F9"/>

                            <!-- Fecha de Vencimiento -->
                            <StackLayout Spacing="6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="FECHA DE VENCIMIENTO"
                                           TextColor="#9CA3AF"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           CharacterSpacing="1.2"
                                           VerticalOptions="Center"/>
                                    <Switch Grid.Column="1"
                                            x:Name="TieneFechaVencimientoSwitch"
                                            OnColor="#4C51BF"
                                            Toggled="OnFechaVencimientoToggled"/>
                                </Grid>
                                <Frame x:Name="FechaVencimientoFrame"
                                       IsVisible="False"
                                       BackgroundColor="#F8FAFF"
                                       CornerRadius="12"
                                       Padding="16,10"
                                       HasShadow="False">
                                    <DatePicker x:Name="FechaVencimientoDatePicker"
                                                Format="dd/MM/yyyy"
                                                TextColor="#4C51BF"
                                                FontSize="18"
                                                FontAttributes="Bold"/>
                                </Frame>
                            </StackLayout>

                            <!-- Campo Cantidad -->
                            <StackLayout Spacing="8">
                                <Label Text="CANTIDAD A REGISTRAR"
                                       TextColor="#9CA3AF"
                                       FontSize="9"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1.2"/>
                                <Frame BackgroundColor="#F8FAFF"
                                       CornerRadius="12"
                                       Padding="16,10"
                                       HasShadow="False">
                                    <Entry x:Name="CantidadEntry"
                                           Text=""
                                           Placeholder="0"
                                           PlaceholderColor="#D1D5DB"
                                           TextColor="#111827"
                                           FontSize="30"
                                           FontAttributes="Bold"
                                           Keyboard="Numeric"
                                           HeightRequest="50"
                                           HorizontalTextAlignment="Center"/>
                                </Frame>
                            </StackLayout>

                            <!-- Botones -->
                            <Button Text="✔  GUARDAR EN UBICACIÓN"
                                    BackgroundColor="#4C51BF"
                                    TextColor="White"
                                    CornerRadius="14"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HeightRequest="52"
                                    Clicked="OnGuardarProductoClicked"/>

                            <Button Text="Cancelar"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#6B7280"
                                    CornerRadius="14"
                                    FontSize="13"
                                    HeightRequest="44"
                                    Clicked="OnCancelarProductoClicked"/>

                        </StackLayout>
                    </Frame>

                    <!-- ══════════════════════════════════════
                         PANEL TRASLADO
                         ══════════════════════════════════════ -->
                    <Frame x:Name="PanelTraslado"
                           IsVisible="False"
                           BackgroundColor="White"
                           CornerRadius="20"
                           Padding="18,16"
                           Margin="16,14,16,0"
                           HasShadow="True">
                        <StackLayout Spacing="16">

                            <!-- Encabezado con producto y disponibles -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackLayout Grid.Column="0" Spacing="4">
                                    <Label Text="⇄  TRASLADO"
                                           TextColor="#059669"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           CharacterSpacing="1"/>
                                    <Label x:Name="TrasladoDescLabel"
                                           Text=""
                                           TextColor="#111827"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           LineBreakMode="WordWrap"/>
                                </StackLayout>
                                <Frame Grid.Column="1"
                                       BackgroundColor="#ECFDF5"
                                       CornerRadius="12"
                                       Padding="10,6"
                                       HasShadow="False"
                                       VerticalOptions="Start">
                                    <StackLayout Spacing="0" HorizontalOptions="Center">
                                        <Label x:Name="TrasladoDisponiblesLabel"
                                               TextColor="#059669"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               HorizontalTextAlignment="Center"/>
                                        <Label Text="disp."
                                               TextColor="#6EE7B7"
                                               FontSize="9"
                                               HorizontalTextAlignment="Center"/>
                                    </StackLayout>
                                </Frame>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#F1F5F9"/>

                            <!-- Fardos + Destino en dos columnas -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                                <!-- Fardos -->
                                <StackLayout Grid.Column="0" Spacing="6">
                                    <Label Text="FARDOS"
                                           TextColor="#9CA3AF"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           CharacterSpacing="1"/>
                                    <Frame BackgroundColor="#F8FAFF"
                                           CornerRadius="12" Padding="10,8" HasShadow="False">
                                        <Entry x:Name="TrasladoFardosEntry"
                                               Text=""
                                               Placeholder="0"
                                               PlaceholderColor="#D1D5DB"
                                               TextColor="#111827"
                                               FontSize="26"
                                               FontAttributes="Bold"
                                               Keyboard="Numeric"
                                               HeightRequest="46"
                                               HorizontalTextAlignment="Center"
                                               ReturnType="Next"
                                               Completed="OnTrasladoFardosCompleted"/>
                                    </Frame>
                                </StackLayout>

                                <!-- Destino -->
                                <StackLayout Grid.Column="1" Spacing="6">
                                    <Label Text="DESTINO"
                                           TextColor="#9CA3AF"
                                           FontSize="9"
                                           FontAttributes="Bold"
                                           CharacterSpacing="1"/>

                                    <!-- Sin destino -->
                                    <Frame x:Name="TrasladoSinDestinoPanel"
                                           BackgroundColor="#F8FAFF"
                                           CornerRadius="12" Padding="10,8" HasShadow="False"
                                           HeightRequest="66">
                                        <StackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="2">
                                            <Label Text="📷" FontSize="20" HorizontalTextAlignment="Center"/>
                                            <Label Text="Escanee QR" TextColor="#9CA3AF"
                                                   FontSize="10" HorizontalTextAlignment="Center"/>
                                        </StackLayout>
                                    </Frame>

                                    <!-- Con destino -->
                                    <Frame x:Name="TrasladoConDestinoPanel"
                                           IsVisible="False"
                                           BackgroundColor="#ECFDF5"
                                           CornerRadius="12" Padding="10,8" HasShadow="False"
                                           HeightRequest="66">
                                        <StackLayout VerticalOptions="Center" Spacing="2">
                                            <Label x:Name="TrasladoDestinoCodigoLabel"
                                                   TextColor="#059669"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   HorizontalTextAlignment="Center"/>
                                            <Label x:Name="TrasladoDestinoDetalleLabel"
                                                   TextColor="#34D399"
                                                   FontSize="9"
                                                   HorizontalTextAlignment="Center"
                                                   LineBreakMode="TailTruncation"/>
                                        </StackLayout>
                                    </Frame>
                                </StackLayout>
                            </Grid>

                            <!-- Campo escaneo destino -->
                            <Frame BackgroundColor="#F8FAFF"
                                   CornerRadius="12" Padding="12,8" HasShadow="False">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Label Grid.Column="0" Text="⌕" FontSize="18"
                                           TextColor="#9CA3AF" VerticalOptions="Center" Margin="0,0,8,0"/>
                                    <Entry Grid.Column="1"
                                           x:Name="TrasladoDestinoEntry"
                                           Placeholder="Escanee QR destino"
                                           PlaceholderColor="#9CA3AF"
                                           TextColor="#1E2235"
                                           FontSize="13"
                                           HeightRequest="36"
                                           ReturnType="Done"
                                           Completed="OnTrasladoDestinoCompleted"/>
                                    <Button Grid.Column="2"
                                            x:Name="CambiarDestinoBtn"
                                            Text="↺"
                                            IsVisible="False"
                                            BackgroundColor="Transparent"
                                            TextColor="#059669"
                                            FontSize="18"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            Padding="0"
                                            Clicked="OnCambiarDestinoClicked"/>
                                </Grid>
                            </Frame>

                            <!-- Botones -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <Button Grid.Column="0"
                                        Text="⇄  CONFIRMAR"
                                        BackgroundColor="#059669"
                                        TextColor="White"
                                        CornerRadius="14"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        HeightRequest="50"
                                        Clicked="OnConfirmarTrasladoClicked"/>
                                <Button Grid.Column="1"
                                        Text="✕"
                                        BackgroundColor="#F1F5F9"
                                        TextColor="#6B7280"
                                        CornerRadius="14"
                                        FontSize="16"
                                        WidthRequest="50"
                                        HeightRequest="50"
                                        Padding="0"
                                        Clicked="OnCancelarTrasladoClicked"/>
                            </Grid>

                        </StackLayout>
                    </Frame>

                    <!-- Lista de productos registrados -->
                    <StackLayout Padding="16,14,16,0" Spacing="0">
                        <Label x:Name="TituloListaLabel"
                               IsVisible="False"
                               Text="REGISTRADOS EN ESTA UBICACIÓN"
                               TextColor="#9CA3AF"
                               FontSize="9"
                               FontAttributes="Bold"
                               CharacterSpacing="1.5"
                               Margin="2,0,0,10"/>

                        <CollectionView x:Name="ProductosCollection"
                                        SelectionMode="None"
                                        VerticalScrollBarVisibility="Never">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Frame Margin="0,0,0,10"
                                           CornerRadius="16"
                                           BackgroundColor="White"
                                           HasShadow="True"
                                           Padding="14,12">
                                        <StackLayout Spacing="8">
                                            <!-- Fila 1: Descripción + ✏ 🗑 -->
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Descripcion}"
                                                       TextColor="#111827"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="WordWrap"
                                                       MaxLines="3"
                                                       VerticalOptions="Center"/>
                                                <Button Grid.Column="1"
                                                        Text="✏"
                                                        BackgroundColor="#EEF2FF" TextColor="#4C51BF"
                                                        CornerRadius="10" WidthRequest="36" HeightRequest="36"
                                                        Padding="0" FontSize="14" VerticalOptions="Start"
                                                        Clicked="OnEditarProductoClicked"/>
                                                <Button Grid.Column="2"
                                                        Text="🗑"
                                                        BackgroundColor="#FFF5F5" TextColor="#EF4444"
                                                        CornerRadius="10" WidthRequest="36" HeightRequest="36"
                                                        Padding="0" FontSize="14" VerticalOptions="Start"
                                                        Clicked="OnEliminarProductoClicked"/>
                                            </Grid>
                                            <!-- Fila 2: UPCs -->
                                            <StackLayout Orientation="Horizontal" Spacing="6">
                                                <Frame BackgroundColor="#EEF2FF"
                                                       CornerRadius="5" Padding="6,3" HasShadow="False">
                                                    <Label Text="{Binding Upc}"
                                                           TextColor="#4C51BF" FontSize="10" FontAttributes="Bold"/>
                                                </Frame>
                                                <Frame BackgroundColor="#F3F0FF"
                                                       CornerRadius="5" Padding="6,3" HasShadow="False">
                                                    <Label Text="{Binding UpcPaquete}"
                                                           TextColor="#7C3AED" FontSize="10" FontAttributes="Bold"/>
                                                </Frame>
                                            </StackLayout>
                                            <!-- Fecha Vencimiento -->
                                            <Frame IsVisible="{Binding TieneFechaVencimiento}"
                                                   BackgroundColor="#FEF3C7"
                                                   BorderColor="#F59E0B"
                                                   CornerRadius="6"
                                                   Padding="8,3"
                                                   HasShadow="False"
                                                   HorizontalOptions="Start">
                                                <Label Text="{Binding TextoFechaVencimiento}"
                                                       TextColor="#92400E"
                                                       FontSize="10"
                                                       FontAttributes="Bold"/>
                                            </Frame>
                                            <!-- Fila 3: Fardos + Cantidad + ⇄ -->
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <StackLayout Grid.Column="0" Orientation="Horizontal" Spacing="8">
                                                    <Frame BackgroundColor="#EEF2FF"
                                                           CornerRadius="8" Padding="10,5" HasShadow="False">
                                                        <Label Text="{Binding ExistenciaFardo, StringFormat='Fardos: {0:0}'}"
                                                               TextColor="#4C51BF" FontSize="12" FontAttributes="Bold"/>
                                                    </Frame>
                                                    <Frame BackgroundColor="#F0FDF4"
                                                           CornerRadius="8" Padding="10,5" HasShadow="False">
                                                        <Label Text="{Binding ExistenciaUnidad, StringFormat='Cant: {0:0}'}"
                                                               TextColor="#059669" FontSize="12" FontAttributes="Bold"/>
                                                    </Frame>
                                                </StackLayout>
                                                <Button Grid.Column="1"
                                                        Text="⇄"
                                                        BackgroundColor="#ECFDF5" TextColor="#059669"
                                                        CornerRadius="10" WidthRequest="36" HeightRequest="36"
                                                        Padding="0" FontSize="14" VerticalOptions="Center"
                                                        Clicked="OnTrasladarProductoClicked"/>
                                            </Grid>
                                        </StackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </StackLayout>

                </StackLayout>
            </ScrollView>

        </Grid>

        <!-- ══════════════════════════════════════
             LOADING OVERLAY
             ══════════════════════════════════════ -->
        <Grid x:Name="LoadingOverlay"
              IsVisible="False"
              BackgroundColor="#CC000000"
              AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="All"
              InputTransparent="False">
            <Frame BackgroundColor="White"
                   CornerRadius="20"
                   Padding="30,24"
                   HasShadow="True"
                   VerticalOptions="Center"
                   HorizontalOptions="Center"
                   WidthRequest="200">
                <StackLayout Spacing="14" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True"
                                       Color="#4C51BF"
                                       WidthRequest="40"
                                       HeightRequest="40"
                                       HorizontalOptions="Center"/>
                    <Label x:Name="LoadingLabel"
                           Text="Cargando..."
                           TextColor="#111827"
                           FontSize="14"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"/>
                </StackLayout>
            </Frame>
        </Grid>

        <!-- ══════════════════════════════════════
             TOAST
             ══════════════════════════════════════ -->
        <Frame x:Name="ToastFrame"
               AbsoluteLayout.LayoutBounds="0.5,0,0.9,-1"
               AbsoluteLayout.LayoutFlags="XProportional,YProportional,WidthProportional"
               CornerRadius="14" Padding="16,12" HasShadow="True"
               Margin="0,20,0,0"
               IsVisible="False" InputTransparent="True"
               BackgroundColor="#10B981">
            <Label x:Name="ToastLabel"
                   Text=""
                   TextColor="White"
                   FontSize="13"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>
        </Frame>

    </AbsoluteLayout>
</ContentPage>