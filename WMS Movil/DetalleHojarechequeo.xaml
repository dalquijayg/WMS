<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:WMS_Movil"
             x:Class="WMS_Movil.DetalleHojarechequeo"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#F1F5F9">

    <ContentPage.Resources>
        <ResourceDictionary>
            <local:StringNotEmptyConverter x:Key="StringNotEmptyConverter"/>
            <local:BoolToOpacityConverter x:Key="BoolToOpacityConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <StackLayout Spacing="0">

                <!-- ══════════════════════════════════════
                     HEADER HERO
                     ══════════════════════════════════════ -->
                <Grid HeightRequest="130">
                    <!-- Fondo base -->
                    <BoxView Color="#4C51BF"/>
                    <!-- Círculo decorativo superior derecho -->
                    <BoxView Color="#5558C8"
                             CornerRadius="100"
                             WidthRequest="200" HeightRequest="200"
                             HorizontalOptions="End" VerticalOptions="Start"
                             TranslationX="75" TranslationY="-75"/>
                    <!-- Círculo decorativo inferior izquierdo -->
                    <BoxView Color="#3D42B0"
                             CornerRadius="60"
                             WidthRequest="120" HeightRequest="120"
                             HorizontalOptions="Start" VerticalOptions="End"
                             TranslationX="-40" TranslationY="45"/>

                    <!-- Contenido del header -->
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          Padding="16,0"
                          VerticalOptions="Center"
                          Margin="0,8,0,0">
                        <Frame Grid.Column="0"
                               BackgroundColor="#3B3FA0"
                               CornerRadius="12"
                               WidthRequest="38" HeightRequest="38"
                               Padding="0" HasShadow="False">
                            <Label Text="←" TextColor="White" FontSize="18"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnBackClicked"/>
                                </Label.GestureRecognizers>
                            </Label>
                        </Frame>

                        <StackLayout Grid.Column="1"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="2">
                            <Label Text="Detalle de Tarima"
                                   TextColor="White"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center"/>
                            <Label x:Name="InfoPedidoLabel"
                                   Text="Pedido #0  •  Tarima #0"
                                   TextColor="#C7D2FE"
                                   FontSize="12"
                                   HorizontalTextAlignment="Center"/>
                            <Label x:Name="EmpresaDepartamentoLabel"
                                   IsVisible="False"
                                   TextColor="#A5B4FC"
                                   FontSize="11"
                                   HorizontalTextAlignment="Center"
                                   LineBreakMode="TailTruncation"/>
                        </StackLayout>

                        <Frame Grid.Column="2"
                               BackgroundColor="#3B3FA0"
                               CornerRadius="12"
                               WidthRequest="38" HeightRequest="38"
                               Padding="7" HasShadow="False">
                            <Label Text="📦" FontSize="16"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"/>
                        </Frame>
                    </Grid>
                </Grid>

                <!-- ══════════════════════════════════════
                     PANEL DE BÚSQUEDA (no guarda nada, solo filtra)
                     ══════════════════════════════════════ -->
                <Frame BackgroundColor="White"
                       CornerRadius="18"
                       Padding="16,14"
                       HasShadow="True"
                       Margin="16,-24,16,0">
                    <StackLayout Spacing="10">

                        <StackLayout Orientation="Horizontal" Spacing="10">
                            <Frame BackgroundColor="#EEF2FF"
                                   CornerRadius="10"
                                   WidthRequest="36" HeightRequest="36"
                                   Padding="0" HasShadow="False">
                                <Label Text="🔎" FontSize="16"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                            </Frame>
                            <StackLayout Spacing="1" VerticalOptions="Center">
                                <Label Text="BUSCAR PRODUCTO"
                                       TextColor="#4C51BF"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       CharacterSpacing="1"/>
                                <Label Text="Escanea o escribe el UPC para encontrarlo"
                                       TextColor="#9CA3AF"
                                       FontSize="10"/>
                            </StackLayout>
                        </StackLayout>

                        <Frame BackgroundColor="#F8FAFF"
                               CornerRadius="10"
                               Padding="12,2"
                               HasShadow="False"
                               BorderColor="#E0E7FF">
                            <Entry x:Name="UpcBuscarEntry"
                                   Placeholder="Escanea o escribe UPC"
                                   PlaceholderColor="#9CA3AF"
                                   TextColor="#1E2235"
                                   FontSize="13"
                                   Keyboard="Numeric"
                                   TextChanged="OnFiltroCambiado"/>
                        </Frame>

                        <Label x:Name="LimpiarFiltroLabel"
                               Text="✕ Limpiar búsqueda"
                               TextColor="#9CA3AF"
                               FontSize="11"
                               HorizontalOptions="End"
                               IsVisible="False">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLimpiarFiltroTapped"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>
                </Frame>

                <!-- ══════════════════════════════════════
                     CONTENIDO
                     ══════════════════════════════════════ -->
                <StackLayout Padding="16,14,16,10" Spacing="14">

                    <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,-4">
                        <Label Grid.Column="0"
                               Text="PRODUCTOS DE LA TARIMA"
                               TextColor="#94A3B8"
                               FontSize="10"
                               FontAttributes="Bold"
                               CharacterSpacing="2"/>
                        <Label Grid.Column="1"
                               x:Name="TotalProductosLabel"
                               Text="0 productos"
                               TextColor="#94A3B8"
                               FontSize="10"
                               FontAttributes="Bold"/>
                    </Grid>

                    <!-- Lista de productos (solo lectura) -->
                    <CollectionView x:Name="ProductosCollection">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Frame Margin="0,0,0,4"
                                       CornerRadius="16"
                                       BackgroundColor="White"
                                       HasShadow="True"
                                       Padding="16,14">
                                    <StackLayout Spacing="8">

                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0"
                                                   Text="{Binding Upc, StringFormat='UPC {0}'}"
                                                   TextColor="#6B7280"
                                                   FontSize="11"
                                                   FontAttributes="Bold"/>
                                            <Label Grid.Column="1"
                                                   Text="{Binding TextoEstado}"
                                                   TextColor="{Binding ColorEstado}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"/>
                                        </Grid>

                                        <Label Text="{Binding Descripcion}"
                                               TextColor="#1E2235"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2"/>

                                        <StackLayout Orientation="Horizontal" Spacing="8">
                                            <Frame BackgroundColor="#FFF5F5"
                                                   CornerRadius="6" Padding="8,4"
                                                   HasShadow="False">
                                                <Label TextColor="#E53E3E" FontSize="11">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding CantidadSolicitada}" FontAttributes="Bold"/>
                                                            <Span Text=" solicitado"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Frame>
                                            <Frame BackgroundColor="#F0FFF4"
                                                   CornerRadius="6" Padding="8,4"
                                                   HasShadow="False">
                                                <Label TextColor="#38A169" FontSize="11">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding CantidadConfirmada}" FontAttributes="Bold"/>
                                                            <Span Text="{Binding TextoConfirmado}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                            </Frame>
                                        </StackLayout>

                                        <!-- Producto repartido en varias tarimas -->
                                        <Frame IsVisible="{Binding EsRepartido}"
                                               BackgroundColor="#ECFDF5"
                                               BorderColor="#059669"
                                               CornerRadius="6"
                                               Padding="8,6"
                                               HasShadow="False">
                                            <Label Text="{Binding DetalleReparto}"
                                                   TextColor="#065F46"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   LineBreakMode="WordWrap"/>
                                        </Frame>

                                        <Label Text="{Binding Observaciones, StringFormat='📝 {0}'}"
                                               TextColor="#9CA3AF"
                                               FontSize="11"
                                               IsVisible="{Binding Observaciones, Converter={StaticResource StringNotEmptyConverter}}"/>

                                        <!-- Botones de revisión (marcar bien / mal) -->
                                        <!-- Se deshabilitan en cuanto el producto ya quedó chequeado -->
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0"
                                              IsEnabled="{Binding PuedeMarcar}"
                                              Opacity="{Binding PuedeMarcar, Converter={StaticResource BoolToOpacityConverter}}">
                                            <Frame Grid.Column="0"
                                                   BackgroundColor="{Binding ColorBotonBien}"
                                                   BorderColor="#48BB78"
                                                   CornerRadius="10"
                                                   Padding="0" HeightRequest="38"
                                                   HasShadow="False">
                                                <Label Text="✓"
                                                       TextColor="{Binding ColorIconoBien}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"/>
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnMarcarBienTapped"/>
                                                </Frame.GestureRecognizers>
                                            </Frame>
                                            <Frame Grid.Column="1"
                                                   BackgroundColor="{Binding ColorBotonMal}"
                                                   BorderColor="#E53E3E"
                                                   CornerRadius="10"
                                                   Padding="0" HeightRequest="38"
                                                   HasShadow="False">
                                                <Label Text="✗"
                                                       TextColor="{Binding ColorIconoMal}"
                                                       FontSize="18"
                                                       FontAttributes="Bold"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center"/>
                                                <Frame.GestureRecognizers>
                                                    <TapGestureRecognizer Tapped="OnMarcarMalTapped"/>
                                                </Frame.GestureRecognizers>
                                            </Frame>
                                        </Grid>

                                        <!-- Resultado guardado del rechequeo -->
                                        <Label Text="{Binding TextoRevision}"
                                               TextColor="{Binding ColorTextoRevision}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               IsVisible="{Binding TieneRevision}"/>
                                    </StackLayout>
                                </Frame>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Sin productos -->
                    <Frame x:Name="SinProductosFrame"
                           IsVisible="False"
                           BackgroundColor="#F8FAFF"
                           CornerRadius="14"
                           Padding="14,12"
                           HasShadow="False">
                        <StackLayout Orientation="Horizontal"
                                     HorizontalOptions="Center"
                                     Spacing="10">
                            <Label Text="ℹ️" FontSize="18" VerticalOptions="Center"/>
                            <Label x:Name="SinProductosLabel"
                                   Text="Esta tarima no tiene productos registrados"
                                   TextColor="#6B7280"
                                   FontSize="13"
                                   VerticalOptions="Center"/>
                        </StackLayout>
                    </Frame>

                </StackLayout>

            </StackLayout>
        </ScrollView>

        <!-- ══════════════════════════════════════
             OVERLAY DE CARGA
             ══════════════════════════════════════ -->
        <Grid x:Name="LoadingOverlay"
              IsVisible="false"
              BackgroundColor="#80000000">
            <Frame BackgroundColor="White"
                   CornerRadius="20"
                   HeightRequest="104"
                   WidthRequest="104"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Padding="0"
                   HasShadow="True">
                <StackLayout VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="8">
                    <ActivityIndicator IsRunning="True"
                                       Color="#4C51BF"
                                       HeightRequest="38"
                                       WidthRequest="38"
                                       HorizontalOptions="Center"/>
                    <Label Text="Cargando..."
                           TextColor="#6B7280"
                           FontSize="11"
                           HorizontalOptions="Center"/>
                </StackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>
