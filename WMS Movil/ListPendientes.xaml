<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WMS_Movil.ListPendientes"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#f8f9fa">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header con título -->
        <Frame Grid.Row="0" 
               BackgroundColor="#E1251D" 
               CornerRadius="0" 
               Padding="15,20"
               HasShadow="True">
            <StackLayout>
                <Label Text="Mis Hojas Asignadas" 
                       TextColor="White" 
                       FontAttributes="Bold"
                       FontSize="20"
                       HorizontalOptions="Center"/>
                <Label x:Name="NombreUsuarioLabel"
                       Text=""
                       TextColor="White" 
                       FontSize="14"
                       HorizontalOptions="Center"/>
            </StackLayout>
        </Frame>

        <!-- Contenido Principal -->
        <StackLayout Padding="15" Grid.Row="1">
            <!-- Buscador -->
            <Frame BackgroundColor="White" 
                   CornerRadius="10" 
                   Padding="5" 
                   HeightRequest="50"
                   Margin="0,0,0,15">
                <Grid ColumnDefinitions="Auto,*">
                    <Image Source="buscar.png" 
                           HeightRequest="20" 
                           Grid.Column="0"
                           Margin="10,0"/>
                    <Entry x:Name="SearchEntry"
                           Placeholder="Buscar por ID de Pedido"
                           PlaceholderColor="#a0aec0"
                           TextColor="Black"
                           Grid.Column="1"
                           Margin="0,-10,0,-10"
                           VerticalOptions="Center"
                           TextChanged="OnSearchTextChanged"/>
                </Grid>
            </Frame>

            <!-- Lista de hojas asignadas -->
            <CollectionView x:Name="HojasCollection"
                           SelectionMode="Single"
                           SelectionChanged="OnHojaSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,0,0,10"
                               CornerRadius="10"
                               BackgroundColor="White"
                               HasShadow="True">
                            <Grid RowSpacing="10" Padding="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Hoja número y estado -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Label Grid.Column="0"
                                           Text="{Binding TituloHoja}"
                                           TextColor="#2d3748"
                                           FontAttributes="Bold"
                                           FontSize="18"/>

                                    <Frame Grid.Column="1"
                                           BackgroundColor="{Binding EstadoColor}"
                                           CornerRadius="12"
                                           Padding="8,4"
                                           HasShadow="False">
                                        <Label Text="{Binding EstadoTexto}"
                                               TextColor="White"
                                               FontSize="12"
                                               FontAttributes="Bold"/>
                                    </Frame>
                                </Grid>

                                <!-- Empresa y Sucursal -->
                                <StackLayout Grid.Row="1" 
                                           Orientation="Horizontal" 
                                           Spacing="10">
                                    <Image Source="tienda.png" 
                                           HeightRequest="20"/>
                                    <Label Text="{Binding Sucursal}"
                                           TextColor="#4a5568"
                                           FontSize="15"/>
                                </StackLayout>

                                <!-- Información de cantidades -->
                                <Grid Grid.Row="2" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Frame Grid.Column="0"
                                           BackgroundColor="#EBF4FF"
                                           CornerRadius="8"
                                           Padding="10,8"
                                           HasShadow="False">
                                        <StackLayout Spacing="2">
                                            <Label Text="Total SKUs"
                                                   TextColor="#4299E1"
                                                   FontSize="11"/>
                                            <Label Text="{Binding TotalSkus}"
                                                   TextColor="#2C5282"
                                                   FontAttributes="Bold"
                                                   FontSize="16"/>
                                        </StackLayout>
                                    </Frame>

                                    <Frame Grid.Column="1"
                                           BackgroundColor="#F0FFF4"
                                           CornerRadius="8"
                                           Padding="10,8"
                                           HasShadow="False">
                                        <StackLayout Spacing="2">
                                            <Label Text="Total Fardos"
                                                   TextColor="#48BB78"
                                                   FontSize="11"/>
                                            <Label Text="{Binding TotalFardos}"
                                                   TextColor="#22543D"
                                                   FontAttributes="Bold"
                                                   FontSize="16"/>
                                        </StackLayout>
                                    </Frame>
                                </Grid>

                                <!-- Progreso -->
                                <StackLayout Grid.Row="3" Spacing="5">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0"
                                               Text="Progreso"
                                               TextColor="#718096"
                                               FontSize="12"/>
                                        <Label Grid.Column="1"
                                               Text="{Binding ProgresoTexto}"
                                               TextColor="#2C5282"
                                               FontSize="12"
                                               FontAttributes="Bold"/>
                                    </Grid>

                                    <Frame BackgroundColor="#E2E8F0"
                                           CornerRadius="8"
                                           Padding="0"
                                           HeightRequest="8"
                                           HasShadow="False">
                                        <Frame BackgroundColor="{Binding ProgresoColor}"
                                               CornerRadius="8"
                                               Padding="0"
                                               WidthRequest="{Binding ProgresoWidth}"
                                               HorizontalOptions="Start"
                                               HasShadow="False"/>
                                    </Frame>
                                </StackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Mensaje cuando no hay hojas -->
            <StackLayout x:Name="EmptyState"
                        IsVisible="False"
                        VerticalOptions="CenterAndExpand"
                        Padding="20">
                <Image Source="empty_box.png"
                       HeightRequest="120"
                       Opacity="0.3"/>
                <Label Text="No tienes hojas asignadas"
                       TextColor="#718096"
                       FontSize="16"
                       HorizontalOptions="Center"
                       Margin="0,20,0,0"/>
            </StackLayout>
        </StackLayout>

        <!-- Overlay de Carga -->
        <Grid x:Name="LoadingOverlay" 
              IsVisible="False"
              BackgroundColor="#80000000"
              Grid.RowSpan="2">
            <Frame BackgroundColor="White"
                   CornerRadius="10"
                   HeightRequest="100"
                   WidthRequest="100"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <StackLayout>
                    <ActivityIndicator x:Name="LoadingIndicator"
                                     IsRunning="True"
                                     Color="#E1251D"
                                     HeightRequest="50"
                                     WidthRequest="50"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center" />
                    <Label Text="Cargando..."
                           TextColor="#2C3E50"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </StackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>