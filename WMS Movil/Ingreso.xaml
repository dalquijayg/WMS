<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:gesture="clr-namespace:Xamarin.Forms;assembly=Xamarin.Forms.Core"
             x:Class="WMS_Movil.Ingreso"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="White">
    <Grid>
        <ScrollView>
            <Grid RowDefinitions="Auto,*,Auto" Padding="20,15">
                <!-- Logo desarrollador más compacto -->
                <Image Grid.Row="0"
                       Source="Logo3.JPG" 
                       HeightRequest="80"
                       Aspect="AspectFit"
                       HorizontalOptions="Center"
                       Margin="0,5,0,10">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="2" 
                                              Tapped="OnLogoTapped"/>
                    </Image.GestureRecognizers>
                </Image>

                <!-- Contenido principal -->
                <Frame Grid.Row="1"
                       Margin="0"
                       CornerRadius="15"
                       HasShadow="True"
                       BackgroundColor="White"
                       Padding="20,15">

                    <StackLayout Spacing="18">
                        <!-- Icono de login más pequeño -->
                        <Image Source="contrasena.png" 
                               HeightRequest="70"
                               Aspect="AspectFit"
                               Margin="0,5,0,0"/>

                        <!-- Título más compacto -->
                        <Label Text="Iniciar Sesión"
                               FontSize="24"
                               TextColor="#2d3748"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               Margin="0,0,0,5"/>

                        <!-- Campos de entrada -->
                        <Frame BorderColor="#e2e8f0" 
                               Padding="15,12" 
                               CornerRadius="10"
                               HasShadow="False">
                            <StackLayout Spacing="15">
                                <!-- Usuario -->
                                <StackLayout Spacing="4">
                                    <Label Text="Usuario"
                                           TextColor="#4a5568"
                                           FontSize="13"
                                           FontAttributes="Bold"/>
                                    <Entry x:Name="UserEntry"
                                           Placeholder="Ingrese su usuario"
                                           PlaceholderColor="#a0aec0"
                                           TextColor="#2d3748"
                                           FontSize="14"
                                           HeightRequest="40"/>
                                </StackLayout>

                                <!-- Contraseña -->
                                <StackLayout Spacing="4">
                                    <Label Text="Contraseña"
                                           TextColor="#4a5568"
                                           FontSize="13"
                                           FontAttributes="Bold"/>
                                    <Grid>
                                        <Entry x:Name="PasswordEntry"
                                               Placeholder="Ingrese su contraseña"
                                               IsPassword="{Binding IsPasswordHidden}"
                                               PlaceholderColor="#a0aec0"
                                               TextColor="#2d3748"
                                               FontSize="14"
                                               HeightRequest="40"/>
                                        <ImageButton Source="contrasena.png"
                                                     HeightRequest="18"
                                                     WidthRequest="18"
                                                     HorizontalOptions="End"
                                                     VerticalOptions="Center"
                                                     Margin="0,0,10,0"
                                                     BackgroundColor="Transparent"
                                                     Clicked="OnTogglePassword"/>
                                    </Grid>
                                </StackLayout>
                            </StackLayout>
                        </Frame>

                        <!-- Botón de ingreso -->
                        <Button x:Name="LoginButton"
                                Text="INGRESAR"
                                Clicked="OnLoginClicked"
                                BackgroundColor="#4c51bf"
                                TextColor="White"
                                CornerRadius="10"
                                HeightRequest="46"
                                FontSize="14"
                                FontAttributes="Bold"
                                Margin="0,5,0,0"/>
                    </StackLayout>
                </Frame>

                <!-- Versión más pequeña -->
                <Label Grid.Row="2"
                       x:Name="VersionLabel"
                       Text="Versión: 1.0.36"
                       TextColor="#a0aec0"
                       FontSize="11"
                       HorizontalOptions="Center"
                       Margin="0,10,0,5"/>
            </Grid>
        </ScrollView>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingOverlay" 
              IsVisible="false"
              BackgroundColor="#80000000">
            <Frame BackgroundColor="White"
                   CornerRadius="10"
                   HeightRequest="90"
                   WidthRequest="90"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   Padding="15">
                <StackLayout Spacing="8">
                    <ActivityIndicator IsRunning="True"
                                       Color="#4c51bf"
                                       HeightRequest="40"
                                       WidthRequest="40"/>
                    <Label Text="Cargando..."
                           TextColor="#2d3748"
                           FontSize="12"
                           HorizontalOptions="Center"/>
                </StackLayout>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>